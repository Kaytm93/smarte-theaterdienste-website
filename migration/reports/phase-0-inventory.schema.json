{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarte-theaterdienste.de/schemas/phase-0-inventory.schema.json",
  "title": "M19 Phase-0-Migrationsinventur",
  "type": "object",
  "required": [
    "reportVersion",
    "generatedAt",
    "sourceRevision",
    "project",
    "sanityTarget",
    "summary",
    "expectedSourceKeys",
    "sourceGroups",
    "mappings",
    "phase2Coverage",
    "parity",
    "qualityIssues",
    "validation"
  ],
  "properties": {
    "reportVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "project": {
      "type": "object",
      "required": ["name", "baseLocale", "locales"],
      "properties": {
        "name": { "type": "string" },
        "baseLocale": { "type": "string" },
        "locales": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "uniqueItems": true
        }
      }
    },
    "sanityTarget": { "type": "object" },
    "summary": {
      "type": "object",
      "required": [
        "physicalLocalFiles",
        "localizedPairs",
        "singletonDocuments",
        "documentsIncludingLocales",
        "entities",
        "assets"
      ],
      "properties": {
        "physicalLocalFiles": { "type": "integer", "minimum": 1 },
        "localizedPairs": { "type": "integer", "minimum": 1 },
        "singletonDocuments": { "type": "integer", "minimum": 1 },
        "documentsIncludingLocales": { "type": "integer", "minimum": 1 },
        "entities": { "type": "object" },
        "assets": { "type": "object" }
      }
    },
    "expectedSourceKeys": { "type": "object" },
    "sourceGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "paths", "canonicality", "targetTypes"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "paths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "canonicality": {
            "enum": ["canonical", "augment", "superseded", "schema-only", "skip"]
          },
          "targetTypes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "mappings": { "type": "array" },
    "phase2Coverage": {
      "type": "object",
      "required": [
        "status",
        "singletonTypes",
        "canonicalResourceDocuments",
        "sharedComicDocuments",
        "eventLifecycle",
        "localeAuthority",
        "protectedTemplateTokens"
      ],
      "properties": {
        "status": { "type": "string" },
        "singletonTypes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "canonicalResourceDocuments": { "type": "integer", "minimum": 1 },
        "reusedResourcePlacements": { "type": "integer", "minimum": 0 },
        "sharedComicDocuments": { "type": "integer", "minimum": 1 },
        "sharedComicFrames": { "type": "integer", "minimum": 1 },
        "eventLifecycle": { "type": "string" },
        "localeAuthority": { "type": "string" },
        "codeOwnedMapConfig": { "type": "string" },
        "protectedTemplateTokens": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "retiredOrCodeOwnedSources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "parity": { "type": "object" },
    "qualityIssues": { "type": "array" },
    "validation": { "type": "object" }
  }
}
